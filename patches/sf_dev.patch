+
 #ifdef UNIVERSAL_BINARY
 namespace Stockfish {
 
@@ -42,12 +44,15 @@ int main(int argc, char* argv[]) {
     Attacks::init();
     Position::init();
 
-    auto cli = CommandLine(argc, argv);
-    auto uci = std::make_unique<UCIEngine>(std::move(cli));
+    auto cli = CommandLine(0, nullptr);
+    uci_global = new UCIEngine(std::move(cli));
 
-    Tune::init(uci->engine_options());
+    Tune::init(uci_global->engine_options());
 
-    uci->loop();
+    uci_global->loop();
+
+    delete uci_global;
+    uci_global = nullptr;
 
     return 0;
 }
